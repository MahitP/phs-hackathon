# Copy to .env and fill in. Everything is optional - SkyWindow runs without any keys.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (AI captain's report)
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=        # https://elevenlabs.io  (captain's voice)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SKYWINDOW_LAT=40.3587
SKYWINDOW_LON=-74.6560
SKYWINDOW_AUTO_ANNOUNCE=0  # 1 = speak automatically on the device whenever the verdict changes
SKYWINDOW_MOCK=0           # 1 = simulated sensors/LCD (laptop development)
